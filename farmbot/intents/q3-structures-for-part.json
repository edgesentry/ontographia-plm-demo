{
  "start": { "class": "Structure", "alias": "structure" },
  "traverse": [
    {
      "relationship": "HAS_USAGE",
      "direction": "out",
      "to": { "class": "Usage", "alias": "usage" }
    },
    {
      "relationship": "USES_ITEM",
      "direction": "out",
      "to": { "class": "Part", "alias": "part" }
    }
  ],
  "filter": [
    { "alias": "part", "property": "name", "op": "eq", "value": "M5 Flange Locknut" }
  ],
  "return": [
    { "alias": "structure", "property": "path", "as_name": "structure" },
    { "alias": "part", "property": "name", "as_name": "part" }
  ],
  "limit": 100
}
