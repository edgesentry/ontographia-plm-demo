{
  "start": { "class": "Kit", "alias": "kit" },
  "traverse": [
    {
      "relationship": "HAS_USAGE",
      "direction": "out",
      "to": { "class": "Usage", "alias": "usage" }
    },
    {
      "relationship": "USES_ITEM",
      "direction": "out",
      "to": { "class": "Part", "alias": "part" }
    },
    {
      "relationship": "IN_CATEGORY",
      "direction": "out",
      "to": { "class": "BomCategory", "alias": "category" }
    }
  ],
  "filter": [
    { "alias": "category", "property": "slug", "op": "eq", "value": "fasteners-and-hardware" }
  ],
  "return": [
    { "alias": "kit", "property": "path", "as_name": "kit" },
    { "alias": "category", "property": "slug", "as_name": "category" },
    { "alias": "part", "property": "name", "as_name": "part" }
  ],
  "limit": 100
}
